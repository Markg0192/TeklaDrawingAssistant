<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>TeklaDrawingAssistant</AssemblyName>
    <RootNamespace>TeklaDrawingAssistant</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Tekla.Structures.Model" Version="2026.0.3" />
    <PackageReference Include="Tekla.Structures.Drawing" Version="2026.0.3" />
    <PackageReference Include="TSAppConfigPatcherTask" Version="2.1.3" PrivateAssets="All" />
  </ItemGroup>
</Project>
